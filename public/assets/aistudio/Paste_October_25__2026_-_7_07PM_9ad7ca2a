                        <i class="fa-solid fa-star cursor-pointer hover:text-gold-500 transition-colors star-icon" onclick="setRating(2)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:text-gold-500 transition-colors star-icon" onclick="setRating(3)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:text-gold-500 transition-colors star-icon" onclick="setRating(4)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:text-gold-500 transition-colors star-icon" onclick="setRating(5)"></i>
                    </div>
                    <input type="hidden" id="selectedRating" value="5">
                </div>

                <!-- Topic Selector -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Chủ Đề Quan Tâm</label>
                    <select id="feedbackTopic" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-navy-900">
                        <option value="Sản Phẩm Gian Hàng">Sản Phẩm Gian Hàng (Deadline Kit, Gimbap, Gà Rán...)</option>
                        <option value="Nội Dung & Chính Sách">Nội Dung Bài Viết & Chính Sách Khởi Nghiệp</option>
                        <option value="Trải Nghiệm Giao Diện">Trải Nghiệm Giao Diện Website</option>
                        <option value="Đóng Góp Khác">Đóng Góp Ý Kiến Khác</option>
                    </select>
                </div>

                <!-- Inputs: Name & Email -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Họ và Tên</label>
                        <input type="text" id="feedbackName" required placeholder="Nguyễn Văn A" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-navy-900">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Email / SĐT</label>
                        <input type="text" id="feedbackContact" required placeholder="email@example.com" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-navy-900">
                    </div>
                </div>

                <!-- Comment Textarea -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nội Dung Phản Hồi / Nhận Xét</label>
                    <textarea id="feedbackComment" rows="3" required placeholder="Chia sẻ cảm nghĩ hoặc góp ý chi tiết của bạn..." class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-navy-900 resize-none"></textarea>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-navy-900 hover:bg-navy-800 text-white font-bold py-3 rounded-xl text-xs sm:text-sm shadow-md transition-all border border-gold-500/30 flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-paper-plane text-gold-400"></i>
                    <span>Gửi Ý Kiến Ngay</span>
                </button>
            </form>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed top-24 right-4 z-50 bg-navy-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-gold-500/40 flex items-center space-x-3 transform translate-x-full transition-transform duration-300">
        <div class="w-8 h-8 rounded-full bg-gold-500 text-navy-950 flex items-center justify-center font-bold">
            <i class="fa-solid fa-check"></i>
        </div>
        <div>
            <p class="text-xs font-bold text-white">Gửi phản hồi thành công!</p>
            <p class="text-[11px] text-slate-300">Cảm ơn bạn đã đóng góp ý kiến cho IR25 Innovation Hub.</p>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Mobile Navigation Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        document.getElementById('mobileMenuBtn').addEventListener('click', toggleMobileMenu);

        // Filter Student Ideas Function
        function filterIdeas(category) {
            const cards = document.querySelectorAll('.idea-card');
            const buttons = document.querySelectorAll('.filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('active', 'bg-navy-900', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });

            event.target.classList.add('active', 'bg-navy-900', 'text-white');
            event.target.classList.remove('bg-white', 'text-slate-700');

            cards.forEach(card => {
                const cardCat = card.getAttribute('data-category');
                if (category === 'all' || cardCat === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Search Student Ideas Function
        function searchIdeas() {
            const query = document.getElementById('searchIdeaInput').value.toLowerCase();
            const cards = document.querySelectorAll('.idea-card');

            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                if (text.includes(query)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Switch Product Tabs
        function switchProductTab(tabKey) {
            const tabs = document.querySelectorAll('.product-tab');
            const contents = document.querySelectorAll('.product-content');

            tabs.forEach(tab => {
                tab.classList.remove('bg-navy-900', 'text-white');
                tab.classList.add('bg-white', 'text-slate-600');
            });

            contents.forEach(content => {
                content.classList.add('hidden');
            });

            const activeTab = document.getElementById(`tab-${tabKey}`);
            const activeContent = document.getElementById(`content-${tabKey}`);

            if (activeTab && activeContent) {
                activeTab.classList.add('bg-navy-900', 'text-white');
                activeTab.classList.remove('bg-white', 'text-slate-600');
                activeContent.classList.remove('hidden');
            }
        }

        // Feedback Modal Controls
        function openFeedbackModal() {
            document.getElementById('feedbackModal').classList.remove('hidden');
        }

        function closeFeedbackModal() {
            document.getElementById('feedbackModal').classList.add('hidden');
        }

        function dismissBottomBar() {
            document.getElementById('bottomPromptBar').style.display = 'none';
        }

        // Star Rating Selection Logic
        let currentRating = 5;
        function setRating(rating) {
            currentRating = rating;
            document.getElementById('selectedRating').value = rating;
            const stars = document.querySelectorAll('.star-icon');

            stars.forEach((star, index) => {
                if (index < rating) {
                    star.classList.add('text-gold-500');
                    star.classList.remove('text-slate-300');
                } else {
                    star.classList.remove('text-gold-500');
                    star.classList.add('text-slate-300');
                }
            });
        }
        // Initialize default rating stars
        setRating(5);

        // Handle Form Submission & LocalStorage Save
        function handleFeedbackSubmit(e) {
            e.preventDefault();

            const feedbackData = {
                rating: currentRating,
                topic: document.getElementById('feedbackTopic').value,
                name: document.getElementById('feedbackName').value,
                contact: document.getElementById('feedbackContact').value,
                comment: document.getElementById('feedbackComment').value,
                timestamp: new Date().toISOString()
            };

            // Store in LocalStorage
            let savedFeedbacks = JSON.parse(localStorage.getItem('ir25_feedbacks') || '[]');
            savedFeedbacks.push(feedbackData);
            localStorage.setItem('ir25_feedbacks', JSON.stringify(savedFeedbacks));

            // Close Modal & Reset Form
            closeFeedbackModal();
            document.getElementById('feedbackForm').reset();
            setRating(5);

            // Show Toast
            showToast();
        }

        // Toast Notification Trigger
        function showToast() {
            const toast = document.getElementById('toast');
            toast.classList.remove('translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3500);
        }
    </script>
</body>
</html>